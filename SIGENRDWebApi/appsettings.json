{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=SIGENRD;Username=postgres;Password=__USER_SECRET__;",
    "IdentityServerDB": "Host=localhost;Port=5432;Database=SIGENRD;Username=postgres;Password=__USER_SECRET__;"
  },
  "JwtSettings": {
    "PrivateKey": "__USER_SECRET__",
    "Issuer": "SIGENRD.API",
    "Audience": "SIGENRD.Client",
    "DurationInMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Storage": {
    "Provider": "AzureBlob",
    "AzureBlob": {
      "ConnectionString": "__USER_SECRET__",
      "ContainerName": "expedientes"
    }
  },
  "MapCache": {
    "Enabled": true,
    "TtlSeconds": 30
  },
  "EmailOutbox": {
    "DispatcherEnabled": true,
    "PollIntervalSeconds": 30,
    "BatchSize": 20,
    "MaxAttempts": 6,
    "KeepSentDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MailSettings": {
    "EmailFrom": "tu_correo@gmail.com",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUser": "__USER_SECRET__",
    "SmtpPass": "__USER_SECRET__",
    "UseStartTls": true,
    "DisplayName": "Equipo SIGENRD"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "PublicTrackingPermitLimit": 30,
    "WindowSeconds": 60
  },
  "AllowedHosts": "*",
  "UseInMemoryDatabase": false
}
