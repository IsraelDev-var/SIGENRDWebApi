{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/SIGENRD.Core.Domain/**",
      "/SIGENRD.Core.Application/**",
      "/SIGENRD.Infrastructure.Persistences/**",
      "/SIGENRD.Infrastructure.Identity/**",
      "/SIGENRD.Infrastructure.Shared/**",
      "/SIGENRDWebApi/**",
      "/Dockerfile",
      "/railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health/live",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
