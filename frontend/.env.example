# Copia este archivo como .env.local para cambiar valores en desarrollo.

# URL base de la API .NET (perfil HTTP local: http://localhost:5116).
ENERGYMAP_API_URL=http://localhost:5116

# Llave pública RSA (PEM/SPKI) correspondiente a JwtSettings:PrivateKey de la API.
# En una sola línea, representa los saltos de línea como \n. No uses aquí la llave privada.
ENERGYMAP_JWT_PUBLIC_KEY=

# Estilos del mapa base (JSON de estilo de MapLibre). Si se dejan vacíos se usa CARTO,
# que solo sirve para desarrollo: el proveedor de producción está pendiente (decisión D-2).
NEXT_PUBLIC_MAP_STYLE_LIGHT=
NEXT_PUBLIC_MAP_STYLE_DARK=

# Catálogo del Design System en /catalogo (solo desarrollo y pruebas; sin esta variable responde 404).
ENERGYMAP_DESIGN_CATALOG=true

# --- Solo servidor (nunca NEXT_PUBLIC_) ---

# URL base de la API .NET, sin /api/v1.
ENERGYMAP_API_URL=http://localhost:5116

# Llave pública RSA (PEM, SPKI) del par con el que la API firma el JWT (JwtSettings:PrivateKey).
# En una sola línea con \n. Se obtiene de la privada con:
#   openssl rsa -in privada.pem -pubout
ENERGYMAP_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Opcionales: deben coincidir con JwtSettings:Issuer y JwtSettings:Audience de la API.
# ENERGYMAP_JWT_ISSUER=SIGENRD.API
# ENERGYMAP_JWT_AUDIENCE=SIGENRD.Client

# Clave compartida con la API (TrustedProxy:Key) para reenviarle la IP del usuario. Sin ella, la API ve la IP de este
# servidor para todos los usuarios y el límite de intentos por IP se aplica al sitio entero. 16 caracteres o más.
# ENERGYMAP_PROXY_KEY=
# Proxies de confianza delante de Next que agregan la IP del usuario a X-Forwarded-For (Azure App Service: 1).
# ENERGYMAP_TRUSTED_PROXIES=1
